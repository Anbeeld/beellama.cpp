{
  "schema_version": 2,
  "inputs": {
    "candidate_manifest": "optimizer-run/run-manifest.json",
    "capture_manifest": "capture.json",
    "native_bridge": "build-sinq-optimizer-cpu/bin/llama-sinq-native.exe",
    "checkpoint": "checkpoint"
  },
  "scoring": {
    "kind": "blockwise_output_mse"
  },
  "execution": {
    "threads": 4,
    "scoring": {
      "device": "cpu",
      "reference_dtype": "fp32"
    }
  },
  "limits": {
    "workspace_bytes": 134217728,
    "max_artifact_bytes": 67108864,
    "max_files": 256,
    "max_tensors": 4,
    "max_tokens": 32,
    "max_block_scores": 128
  },
  "output": {
    "directory": "score-cpu-fp32"
  }
}
