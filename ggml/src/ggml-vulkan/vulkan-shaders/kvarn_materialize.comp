#version 450

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform parameter {
    uint n_heads;
    uint n_kv;
    uint stream_start;
    uint n_stream;
    uint groups_per_stream;
    uint record_words;
    uint bits;
    uint value;
    uint n_indices;
    uint emit_rotated;
    uint head_slices;
    uint swa;
    uint stage_groups;
    uint tail_groups;
    uint eager_records;
    uint read_indirect;
    uint blocks_x;
    uint total_blocks;
    uint mode;
} p;

layout(binding = 0, std430) readonly buffer Records { uint data_records[]; };
layout(binding = 1, std430) readonly buffer Stage { uint data_stage[]; };
layout(binding = 2, std430) readonly buffer Indices { uint data_indices[]; };
layout(binding = 3, std430) buffer Dst { uint data_dst[]; };
layout(binding = 4, std430) buffer Live { uint data_live[]; };

const uint KVAR_N_DIM = 128;
const float KVAR_N_WHT_SCALE = 0.08838834764831845;
const uint MODE_MATERIALIZE = 0u;
const uint MODE_PREPARE_LIVE = 1u;
shared float sh_wht[128];
shared uint sh_live_group[128];
shared uint sh_live_pos[128];

uint read_index_low(uint token) { return data_indices[2 * token]; }

int read_cell(uint token, out bool explicitly_staged) {
    const int encoded = int(read_index_low(token));
    explicitly_staged = encoded < -1;
    return explicitly_staged ? -encoded - 2 : encoded;
}

float load_stage_value(uint stage_pos, uint head, uint dim) {
    const uint word = data_stage[(stage_pos * p.n_heads + head) * 64 + (dim >> 1)];
    const vec2 v = unpackHalf2x16(word);
    return (dim & 1u) == 0u ? v.x : v.y;
}

uint unpack_record_value(uint record_base, uint index) {
    const uint bit_offset = index * p.bits;
    const uint word_index = bit_offset >> 5;
    const uint bit = bit_offset & 31u;
    uint v = data_records[record_base + word_index] >> bit;
    if (bit + p.bits > 32u) {
        v |= data_records[record_base + word_index + 1u] << (32u - bit);
    }
    return v & ((1u << p.bits) - 1u);
}

float load_axis_value(uint record_base, uint payload_words, uint axis, uint index) {
    const vec2 v = unpackHalf2x16(data_records[record_base + payload_words + axis * 64u + (index >> 1)]);
    return (index & 1u) == 0u ? v.x : v.y;
}

void compute_live(uint stream, uint lane, out uint group_out, out uint pos_out) {
    uint live_group = 0u;
    uint live_pos = 0u;
    for (uint i = lane; i < p.n_indices; i += KVAR_N_DIM) {
        bool explicitly_staged;
        const int idx = read_cell(i, explicitly_staged);
        if (idx == -1) { continue; }
        const uint group_global = uint(idx) / KVAR_N_DIM;
        const uint idx_stream = p.swa != 0u ? stream : group_global / p.groups_per_stream;
        if (idx_stream != stream) { continue; }
        const uint group = p.swa != 0u ? group_global : group_global - stream * p.groups_per_stream;
        const uint pos = uint(idx) % KVAR_N_DIM;
        if (group > live_group || (group == live_group && pos > live_pos)) {
            live_group = group;
            live_pos = pos;
        }
    }
    sh_live_group[lane] = live_group;
    sh_live_pos[lane] = live_pos;
    barrier();
    for (uint stride = 64u; stride > 0u; stride >>= 1u) {
        if (lane < stride) {
            const uint other_group = sh_live_group[lane + stride];
            const uint other_pos = sh_live_pos[lane + stride];
            if (other_group > sh_live_group[lane] ||
                    (other_group == sh_live_group[lane] && other_pos > sh_live_pos[lane])) {
                sh_live_group[lane] = other_group;
                sh_live_pos[lane] = other_pos;
            }
        }
        barrier();
    }
    group_out = sh_live_group[0];
    pos_out = sh_live_pos[0];
}

void prepare_live(uint lane) {
    const uint out_stream = gl_WorkGroupID.x;
    if (out_stream >= p.n_stream) {
        return;
    }
    uint live_group;
    uint live_pos;
    compute_live(
        p.stream_start + out_stream, lane, live_group, live_pos);
    if (lane == 0u) {
        data_live[2u * out_stream + 0u] = live_group;
        data_live[2u * out_stream + 1u] = live_pos;
    }
}

void wht_128(uint lane) {
    barrier();
    for (uint stride = 1u; stride < KVAR_N_DIM; stride <<= 1u) {
        if (lane < 64u) {
            const uint j = (lane / stride) * (2u * stride) + lane % stride;
            const float a = sh_wht[j];
            const float b = sh_wht[j + stride];
            sh_wht[j] = a + b;
            sh_wht[j + stride] = a - b;
        }
        barrier();
    }
    sh_wht[lane] *= KVAR_N_WHT_SCALE;
    barrier();
}

float load_materialized(
        uint head,
        uint token,
        uint stream,
        uint live_group,
        uint live_pos,
        uint lane) {
    bool explicitly_staged = false;
    const int abs_pos_i = (p.swa != 0u || p.read_indirect != 0u) ?
        read_cell(token, explicitly_staged) : int(token);
    if (abs_pos_i == -1) {
        return 0.0;
    }

    const uint group = uint(abs_pos_i) / KVAR_N_DIM;
    const uint pos = uint(abs_pos_i) % KVAR_N_DIM;
    bool from_stage = false;
    bool from_record = false;
    if (explicitly_staged) {
        from_stage = true;
    } else if (p.read_indirect != 0u && p.swa == 0u) {
        from_stage = explicitly_staged;
        from_record = !from_stage;
    } else if (p.eager_records != 0u) {
        from_stage = (p.swa == 0u && group == 0u) || (group == live_group && live_pos < 127u);
        const bool completed = group < live_group || (group == live_group && live_pos == 127u);
        from_record = !from_stage && completed && (p.swa != 0u ?
            (group <= live_group && live_group - group < p.groups_per_stream) :
            (group > 0u && group < p.groups_per_stream));
    } else if (p.swa != 0u) {
        const uint stage_begin = live_group >= p.tail_groups - 1u ? live_group - (p.tail_groups - 1u) : 0u;
        from_stage = group >= stage_begin && group <= live_group;
        from_record = !from_stage && group < stage_begin &&
            live_group - group < p.groups_per_stream + p.tail_groups;
    } else {
        from_stage = group == 0u || (group > 0u && group <= live_group &&
            group + (p.tail_groups - 1u) >= live_group);
        from_record = !from_stage && group < live_group && group < p.groups_per_stream;
    }

    if (from_stage) {
        const uint stage_slot = p.swa != 0u ? group % p.stage_groups :
            (group == 0u ? 0u : 1u + ((group - 1u) % p.tail_groups));
        const uint stage_pos = stream * KVAR_N_DIM * p.stage_groups + stage_slot * KVAR_N_DIM + pos;
        return load_stage_value(stage_pos, head, lane);
    }
    if (from_record) {
        const uint ring = p.swa != 0u ? group % p.groups_per_stream : group;
        const uint record_base = ((stream * p.groups_per_stream + ring) * p.n_heads + head) * p.record_words;
        const uint row = p.value != 0u ? pos : lane;
        const uint col = p.value != 0u ? lane : pos;
        const uint payload_words = p.bits * 512u;
        const uint q = unpack_record_value(record_base, row * KVAR_N_DIM + col);
        const float scale = load_axis_value(
            record_base, payload_words, 0u, row);
        const float zp = load_axis_value(
            record_base, payload_words, 1u, row);
        const float other = load_axis_value(
            record_base, payload_words, 2u, col);
        return (float(q) * scale + zp) * other;
    }
    return 0.0;
}

void main() {
    const uint lane = gl_LocalInvocationID.x;
    if (p.mode == MODE_PREPARE_LIVE) {
        prepare_live(lane);
        return;
    }
    const uint flat_block = gl_WorkGroupID.x + gl_WorkGroupID.y * p.blocks_x;
    if (flat_block >= p.total_blocks) {
        return;
    }
    const uint logical_heads = p.n_heads / p.head_slices;
    const uint logical_head = flat_block % logical_heads;
    const uint head0 = logical_head * p.head_slices;
    const uint token_stream = flat_block / logical_heads;
    const uint token = token_stream % p.n_kv;
    const uint out_stream = token_stream / p.n_kv;
    const uint stream = p.stream_start + out_stream;
    const uint live_group = data_live[2u * out_stream + 0u];
    const uint live_pos = data_live[2u * out_stream + 1u];

    float values[4] = float[4](0.0, 0.0, 0.0, 0.0);
    for (uint slice = 0u; slice < p.head_slices; ++slice) {
        float x = load_materialized(head0 + slice, token, stream, live_group, live_pos, lane);
        if (p.emit_rotated == 0u) {
            sh_wht[lane] = x;
            wht_128(lane);
            x = sh_wht[lane];
        }
        values[slice] = x;
    }

    if (p.emit_rotated == 0u && p.head_slices == 2u) {
        const float a = values[0];
        const float b = values[1];
        values[0] = (a + b) * 0.7071067811865475;
        values[1] = (a - b) * 0.7071067811865475;
    } else if (p.emit_rotated == 0u && p.head_slices == 4u) {
        const float a = values[0];
        const float b = values[1];
        const float c = values[2];
        const float d = values[3];
        values[0] = (a + b + c + d) * 0.5;
        values[1] = (a - b + c - d) * 0.5;
        values[2] = (a + b - c - d) * 0.5;
        values[3] = (a - b - c + d) * 0.5;
    }

    for (uint slice = 0u; slice < p.head_slices; ++slice) {
        sh_wht[lane] = values[slice];
        barrier();
        if (lane < 64u) {
            const uint head = head0 + slice;
            const uint base = ((out_stream * p.n_kv + token) * p.n_heads + head) * 64u;
            data_dst[base + lane] = packHalf2x16(vec2(sh_wht[2u * lane], sh_wht[2u * lane + 1u]));
        }
        barrier();
    }
}
